<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"> <!-- Define el redondeo y la sombra de la tarjeta -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- 1. SECCIÓN DE IMAGEN -->
        <ImageView
            android:id="@+id/imgLocal"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_ues"
            android:background="@android:color/darker_gray"/>

        <!-- 2. SECCIÓN DE INFORMACIÓN (Contenido Vertical) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <!-- Título del Cafetín -->
            <TextView
                android:id="@+id/tvNombreLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Local"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@android:color/black"/>

            <!-- Ubicación Física -->
            <TextView
                android:id="@+id/tvUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ubicación"
                android:textSize="14sp"/>

            <!-- Descripción (limitada a 3 líneas para no romper el diseño) -->
            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Descripción detallada aquí..."
                android:textSize="14sp"
                android:maxLines="3"/>

            <!-- 3. INDICADOR DE ESTADO Y BOTÓN ACCIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <!-- Punto de color (Verde para Activo / Rojo para Inactivo) -->
                <View
                    android:id="@+id/estadoColor"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/holo_green_dark"/>

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Activo"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <!-- Botón para ir a Editar el local -->
                <Button
                    android:id="@+id/btnEditar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar"
                    app:icon="@drawable/ic_edit"
                    android:backgroundTint="@color/wine"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>