<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProductosActivity">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/lytTopBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/wine"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÓN VOLVER -->

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/volver"/>

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/lblTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/productos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:textColor="@color/white"/>

        <!-- ESPACIO FLEXIBLE -->

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- CARRITO -->

        <ImageView
            android:id="@+id/imgCarrito"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_shopping_car"
            android:contentDescription="@string/carrito"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- SCROLL -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/lytTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lytContainerProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- NOMBRE LOCAL -->

            <TextView
                android:id="@+id/lblNombreLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cafetin_central"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- INDICACIÓN -->

            <TextView
                android:id="@+id/lblIndicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selecciona_productos"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- ========================= -->
            <!-- CARD PRODUCTO -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/lytCardProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/dialog_holo_light_frame">

                <!-- IMAGEN -->

                <ImageView
                    android:id="@+id/imgProducto"
                    android:layout_width="100dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/logo_ues"/>

                <!-- CONTENIDO -->

                <LinearLayout
                    android:id="@+id/lytInfoProducto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <!-- NOMBRE Y PRECIO -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblNombreProducto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pupusas"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/lblPrecioProducto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.75"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <!-- ESTADO -->

                    <TextView
                        android:id="@+id/lblEstadoProducto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/disponible"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <!-- TIPO Y BOTÓN -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/lblTipoProducto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/antojito"
                            android:padding="6dp"
                            android:textSize="12sp"
                            android:background="@android:drawable/btn_default_small"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <Button
                            android:id="@+id/btnAgregarProducto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/agregar"
                            android:backgroundTint="@color/wine"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- BOTÓN CARRITO -->

            <Button
                android:id="@+id/btnVerCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ver_carrito"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/wine"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>